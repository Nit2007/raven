{
  "manifest_version": 3,
  "name": "Local Perception Agent - Person 2",
  "version": "1.0.0",
  "description": "On-device AI-powered visual perception engine for browser agents (SIH 2026 PS 26171)",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"]
    }
  ],
  "action": {
    "default_title": "Local Visual Perception Agent",
    "default_popup": "extension/popup/popup.html"
  }
}
